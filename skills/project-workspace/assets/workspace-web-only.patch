+import type { WorkspaceEntity, WorkspaceProject } from '../types'
+import { projectHash } from '../lib/route'
+import { contentUrl } from '../desktop/client'
+import { Icon } from '../desktop/Icons'
+
+export default function ProjectLibrary({ projects, entities, query, offline }: {
+  projects: WorkspaceProject[]; entities: WorkspaceEntity[]; query: string; offline: boolean
+}) {
+  const search = query.trim().toLowerCase()
+  const visible = projects.filter(project => `${project.title} ${project.description}`.toLowerCase().includes(search))
+  return <section className="project-library" aria-labelledby="projects-title">
+    <header className="library-header">
+      <h1 id="projects-title">Projects</h1>
+      <p>Game worlds, references and production documents in one place.</p>
+    </header>
+    {offline && <p className="workspace-notice" role="status">The source index is unavailable. Reload the page to try again.</p>}
+    <div className="project-grid">
+      {visible.map(project => <a className="project-card" key={project.id} href={projectHash(project.id)}>
+        {project.cover ? <img className="project-cover" src={contentUrl(project.cover)} alt={`${project.title} — ${project.coverLabel || 'project reference'}`} /> : <div className="project-cover project-cover-empty"><Icon name="projects" size={40} /></div>}
+        <div className="project-card-body">
+          {project.coverLabel && <p className="project-cover-note">{project.coverLabel}</p>}
+          <h2>{project.title}</h2><p>{project.description}</p>
+          <div className="project-card-footer"><span>{entities.filter(entity => entity.projectId === project.id).length} collections</span><span>Open project <Icon name="arrow" size={16} /></span></div>
+        </div>
+      </a>)}
+    </div>
+    {!visible.length && !offline && <p className="workspace-empty" role="status">{search ? `No projects match “${query.trim()}”.` : <>No projects yet. Add a project and its collections to <code>workspace.config.json</code>.</>}</p>}
+    <p className="workspace-readonly">Read-only workspace. Agents update the original project files.</p>
+  </section>
+}

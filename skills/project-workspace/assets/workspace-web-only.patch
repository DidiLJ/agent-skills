--- /dev/null
+++ b/src/components/ProjectOverview.tsx
@@ -0,0 +1,48 @@
+import { useState } from 'react'
+import type { WorkspaceEntity, WorkspaceProject } from '../types'
+import { entityHash } from '../lib/route'
+import { categoryIcon } from '../lib/categories'
+import { contentUrl } from '../desktop/client'
+import { Icon } from '../desktop/Icons'
+import { ZoomImage } from './ImagePreview'
+
+function VisualCollection({ entity, title }: { entity: WorkspaceEntity; title: string }) {
+  const images = entity.steps.map((step, index) => ({ ...step, index })).filter(step => /\.(png|jpe?g|webp|gif|svg)$/i.test(step.path))
+  const [selected, setSelected] = useState(images[0]?.index)
+  const image = images.find(step => step.index === selected) || images[0]
+  if (!image) return null
+  return <section className="project-visual" aria-label={title}>
+    <header><h2>{title}</h2><a href={entityHash(entity.id, image.index)} aria-label={`Open ${entity.title}`}><Icon name="external" size={17} /></a></header>
+    <p>{entity.description}</p>
+    {images.length > 1 && <select aria-label={`Choose ${title.toLowerCase()}`} value={image.index} onChange={event => setSelected(Number(event.target.value))}>{images.map(step => <option key={step.index} value={step.index}>{step.name}</option>)}</select>}
+    <figure><ZoomImage src={contentUrl(`/workspace/${entity.folder}/${image.path}`)} alt={image.name} /><figcaption>{image.name}</figcaption></figure>
+  </section>
+}
+
+export default function ProjectOverview({ project, entities, query }: {
+  project: WorkspaceProject; entities: WorkspaceEntity[]; query: string
+}) {
+  const search = query.trim().toLowerCase()
+  const visible = entities.filter(entity => `${entity.title} ${entity.description} ${entity.category}`.toLowerCase().includes(search))
+  const target = entities.find(entity => entity.role === 'visual-targets')
+  const evidence = entities.find(entity => entity.role === 'in-engine-evidence')
+  return <section className="project-overview" aria-labelledby="project-title">
+    <header className="project-heading"><div><h1 id="project-title">{project.title}</h1><p>{project.description}</p></div><span className="readonly-label"><Icon name="files" size={16} /> Source documents</span></header>
+    <div className={`project-overview-grid${target || evidence ? ' has-visuals' : ''}`}>
+      <section className="project-documents" aria-labelledby="project-documents-title">
+        <h2 id="project-documents-title">Project documents</h2>
+        <p>Decisions, next steps and production evidence.</p>
+        <div className="collection-list">{visible.map(entity => <a key={entity.id} className="collection-row" href={entityHash(entity.id)}>
+          <span className="collection-icon"><Icon name={categoryIcon(entity.category)} size={21} /></span>
+          <div><h3>{entity.title}</h3><p>{entity.description}</p></div>
+          <span className="collection-tail"><span>{entity.steps.length} {entity.steps.length === 1 ? 'tab' : 'tabs'}</span><Icon name="arrow" size={17} /></span>
+        </a>)}</div>
+        {!visible.length && <p className="workspace-empty">{search ? `No collections match “${query.trim()}”.` : 'No collections are registered for this project.'}</p>}
+      </section>
+      {(target || evidence) && <aside className="project-visuals" aria-label="Visual references and current results">
+        {target && <VisualCollection key={target.id} entity={target} title="Visual targets" />}
+        {evidence && <VisualCollection key={evidence.id} entity={evidence} title="In-engine evidence" />}
+      </aside>}
+    </div>
+  </section>
+}

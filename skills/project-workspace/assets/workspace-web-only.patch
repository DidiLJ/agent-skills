+  }
+  for (const entity of config.entities) {
+    if (!/^[a-z0-9][a-z0-9_.-]*$/.test(entity.id) || entities.has(entity.id) || !projects.has(entity.projectId) ||
+        typeof entity.title !== 'string' || typeof entity.folder !== 'string' || !Array.isArray(entity.steps))
+      throw new Error('Invalid collection or project reference.');
+    for (const step of entity.steps) if (typeof step.name !== 'string' || typeof step.path !== 'string')
+      throw new Error('Invalid document entry.');
+    entities.add(entity.id);
+  }
+  for (const project of config.projects) if (project.defaultEntityId &&
+      !config.entities.some(entity => entity.id === project.defaultEntityId && entity.projectId === project.id))
+    throw new Error('Project overview must belong to its project.');
+  for (const sources of [config.sourceRoots || {}, config.sourceFiles || {}]) {
+    for (const [alias, entry] of Object.entries(sources)) {
+      const target = typeof entry === 'string' ? entry : entry.path;
+      if (!/^[a-zA-Z0-9_-][a-zA-Z0-9_./-]*$/.test(alias) || alias.split('/').some(part => part.startsWith('.')) ||
+          typeof target !== 'string' || !path.isAbsolute(target)) throw new Error('Source aliases need explicit absolute local paths.');
+    }
+  }
+  return config;
+}
+
+// Trusted local configuration only. The HTTP interface never writes this file.
+export async function loadWorkspaceConfig(file = configPath) {
+  return validateConfig(JSON.parse(await readFile(file, 'utf8')));
+}
+
+function sourceMappings(config) {
+  const files = new Map(Object.entries(config.sourceFiles || {}).map(([alias, file]) => [`/workspace/${alias}`, file]));
+  for (const name of ['draco_decoder.js', 'draco_decoder.wasm', 'draco_wasm_wrapper.js'])
+    files.set(`/workspace/decoders/${name}`, `${app}/node_modules/three/examples/jsm/libs/draco/gltf/${name}`);
+  const roots = new Map(Object.entries(config.sourceRoots || {}).map(([alias, entry]) => [`/workspace/${alias}/`, entry]));
+  return { files, roots };
+}
+
+export function requestPath(url) {
+  let pathname;
+  try { pathname = decodeURIComponent(url.split(/[?#]/, 1)[0]); } catch { throw failure(400, 'Invalid address.'); }
+  const parts = pathname.split('/');
+  if (pathname.includes('\\') || pathname.includes('\0') || /%[a-f0-9]{2}/i.test(pathname) ||
+      parts.some(part => part === '.' || part === '..' || part === '.git') ||
+      (pathname.startsWith('/workspace/') && parts.some(part => part.startsWith('.'))))
+    throw failure(403, 'Path not allowed.');
+  return pathname;
+}
+
+export async function sourceFile(urlPath, fileMappings, rootMappings) {
+  let file = fileMappings.get(urlPath), root, extensions;
+  if (!file) {
+    const entry = [...rootMappings].sort((a, b) => b[0].length - a[0].length).find(([prefix]) => urlPath.startsWith(prefix));
+    if (!entry) throw failure(404, 'Source not registered.');
+    const [prefix, source] = entry;
+    root = path.resolve(typeof source === 'string' ? source : source.path);
+    extensions = typeof source === 'string' ? undefined : source.extensions;
+    file = path.resolve(root, urlPath.slice(prefix.length));
+    if (!inside(root, file)) throw failure(403, 'Path outside registered source.');
+  }
+  const extension = path.extname(file).toLowerCase();
+  if (!mime[extension] || (extensions && !extensions.includes(extension)) ||
+      (!fileMappings.has(urlPath) && ['.js', '.wasm'].includes(extension)))
+    throw failure(403, 'File type not allowed.');
+  const actual = await realpath(file);
+  if (!same(path.resolve(file), actual) || (root && !inside(await realpath(root), actual)))
+    throw failure(403, 'Linked path not allowed.');
+  const info = await stat(actual);
+  if (!info.isFile()) throw failure(404, 'Source not found.');
+  return { file: actual, size: info.size, type: mime[extension] };
+}
+
+export function previewMiddleware(request, response, next) {
+  const send = (status, text, type = 'text/plain; charset=utf-8') => {
+    response.writeHead(status, { 'Content-Type': type, 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff' });
+    response.end(request.method === 'HEAD' ? undefined : text);
+  };
+  void (async () => {
+    if (!/^127\.0\.0\.1(?::\d+)?$/.test(request.headers.host || '')) throw failure(403, 'Local access only.');
+    if (request.headers.origin && request.headers.origin !== `http://${request.headers.host}`) throw failure(403, 'Origin not allowed.');
+    if (!['GET', 'HEAD'].includes(request.method)) throw failure(405, 'Read-only workspace.');
+    const pathname = requestPath(request.url || '/');
+    if (pathname.startsWith('/api/') || pathname.startsWith('/@fs/') || pathname.startsWith('/__open-in-editor') ||
+        pathname === '/mobile' || new URL(request.url, 'http://127.0.0.1').searchParams.has('desktop'))
+      throw failure(403, 'Desktop and agent services are disabled.');
+    if (!pathname.startsWith('/workspace/')) return next();
+    let config;
+    try { config = await loadWorkspaceConfig(); } catch { throw failure(503, 'Workspace configuration unavailable or invalid. Check the local configuration file.'); }
+    if (pathname === '/workspace/workspace.json') return send(200, JSON.stringify({ brand: config.brand, projects: config.projects, entities: config.entities }), 'application/json');
+    const { files, roots } = sourceMappings(config);
+    const source = await sourceFile(pathname, files, roots);
+    response.writeHead(200, { 'Content-Type': source.type, 'Content-Length': source.size, 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff',
+      'Content-Security-Policy': "sandbox; default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'", 'Referrer-Policy': 'no-referrer' });
+    if (request.method === 'HEAD') return response.end();
+    const stream = createReadStream(source.file);
+    stream.on('error', () => response.destroy());
+    response.on('close', () => stream.destroy());
+    stream.pipe(response);
+  })().catch(error => send(error.status || (error.code === 'ENOENT' ? 404 : 500),
+    error.status ? error.message : error.code === 'ENOENT' ? 'Document unavailable at its source.' : 'Source temporarily unavailable.'));
+}
+
+export function arcadePreview() {
+  return { name: 'project-readonly-workspace', configureServer(server) { server.middlewares.use(previewMiddleware); } };
+}

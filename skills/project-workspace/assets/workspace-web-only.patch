@@ -0,0 +1,70 @@
+import assert from 'node:assert/strict';
+import { mkdtemp, mkdir, writeFile, symlink, rm } from 'node:fs/promises';
+import { request } from 'node:http';
+import { createServer } from 'node:http';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { test } from 'node:test';
+import { previewMiddleware, loadWorkspaceConfig, validateConfig, requestPath, sourceFile } from './arcade-preview.mjs';
+
+test('read-only source boundary, exact mappings and live files', async () => {
+  const registry = await loadWorkspaceConfig();
+  const tools = path.dirname(fileURLToPath(import.meta.url));
+  const folder = await mkdtemp(path.join(tools, '.preview-check-'));
+  const root = path.join(folder, 'docs');
+  let server;
+  try {
+    await mkdir(root);
+    const file = path.join(root, 'note.md');
+    await writeFile(file, 'version one');
+    const roots = new Map([['/workspace/test/', root]]);
+    assert.equal((await sourceFile('/workspace/test/note.md', new Map(), roots)).size, 11);
+    await writeFile(file, 'version two changed');
+    assert.equal((await sourceFile('/workspace/test/note.md', new Map(), roots)).size, 19);
+    for (const url of ['/workspace/test/../secret.md', '/workspace/test/%2e%2e/secret.md', '/workspace/test/%252e%252e/secret.md', '/workspace/test/a%5cb.md', '/workspace/test/%00.md', '/workspace/test/.env', '/.git/config']) assert.throws(() => requestPath(url));
+    assert.equal(requestPath('/node_modules/.vite/deps/react.js?v=123'), '/node_modules/.vite/deps/react.js');
+    await assert.rejects(sourceFile('/workspace/test/../../secret.md', new Map(), roots));
+    await writeFile(path.join(root, 'unsafe.html'), '<script>bad()</script>');
+    await assert.rejects(sourceFile('/workspace/test/unsafe.html', new Map(), roots));
+    await writeFile(path.join(folder, 'secret.md'), 'private fixture');
+    await symlink(folder, path.join(root, 'escape'), 'junction');
+    await assert.rejects(sourceFile('/workspace/test/escape/secret.md', new Map(), roots));
+    assert.equal((await sourceFile('/workspace/exact.md', new Map([['/workspace/exact.md', file]]), new Map())).size, 19);
+    server = createServer((req, res) => previewMiddleware(req, res, () => { res.writeHead(404); res.end(); }));
+    await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+    const port = server.address().port;
+    const fetchPath = (url, method = 'GET', headers = {}) => new Promise((resolve, reject) => {
+      const req = request({ hostname: '127.0.0.1', port, path: url, method, headers }, res => { let body = ''; res.setEncoding('utf8'); res.on('data', chunk => { body += chunk; }); res.on('end', () => resolve({ status: res.statusCode, body })); });
+      req.on('error', reject); req.end();
+    });
+    assert.equal((await fetchPath('/workspace/workspace.json')).status, 200);
+    assert.equal((await fetchPath('/workspace/workspace.json', 'POST')).status, 405);
+    assert.equal((await fetchPath('/api/bootstrap')).status, 403);
+    assert.equal((await fetchPath('/__open-in-editor?file=example.md')).status, 403);
+    assert.equal((await fetchPath('/@fs/private-project/package.json')).status, 403);
+    assert.equal((await fetchPath('/?desktop=1')).status, 403);
+    assert.equal((await fetchPath('/workspace/workspace.json', 'GET', { Origin: 'https://example.org' })).status, 403);
+    assert.equal((await fetchPath('/workspace/%2e%2e/.env')).status, 403);
+    for (const entity of registry.entities) for (const step of entity.steps) {
+      const url = new URL(`/workspace/${entity.folder}/${step.path}`, `http://127.0.0.1:${port}`);
+      const result = await fetchPath(url.pathname);
+      assert.equal(result.status, 200, url.pathname);
+    }
+  } finally {
+    if (server) await new Promise(resolve => server.close(resolve));
+    assert.ok(path.resolve(folder).startsWith(`${path.resolve(tools)}${path.sep}.preview-check-`));
+    await rm(folder, { recursive: true, force: true });
+  }
+});
+
+test('projects share the viewer without sharing identity or source access', () => {
+  const first = { id: 'first', title: 'First game', defaultEntityId: 'first-guide' };
+  const second = { id: 'second', title: 'Second game', defaultEntityId: 'second-guide' };
+  const entry = (id, projectId) => ({ id, projectId, title: 'Guide', folder: projectId, steps: [{ name: 'Guide', path: 'README.md' }] });
+  const config = { schemaVersion: 1, projects: [first, second], entities: [entry('first-guide', 'first'), entry('second-guide', 'second')], sourceRoots: {}, sourceFiles: {} };
+  assert.equal(validateConfig(config).projects.length, 2);
+  assert.throws(() => validateConfig({ ...config, projects: [first, first] }));
+  assert.throws(() => validateConfig({ ...config, entities: [entry('bad', 'unknown')] }));
+  assert.throws(() => validateConfig({ ...config, projects: [{ ...first, defaultEntityId: 'second-guide' }, second] }));
+  assert.throws(() => validateConfig({ ...config, sourceFiles: { 'escape/../file': '/tmp/file' } }));
+});

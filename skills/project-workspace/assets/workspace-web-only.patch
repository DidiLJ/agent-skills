+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { entityHash, parseHash, projectHash, resolveStep } from './route.ts';
+
+test('project routes preserve existing collection deep links', () => {
+  assert.deepEqual(parseHash(''), { id: null, step: -1 });
+  assert.deepEqual(parseHash('#/project/arcade'), { id: null, step: -1, projectId: 'arcade' });
+  assert.deepEqual(parseHash(projectHash('future game')), { id: null, step: -1, projectId: 'future game' });
+  assert.deepEqual(parseHash(entityHash('etat', 2)), { id: 'etat', step: 2 });
+  assert.equal(parseHash('#/etat/-2').step, -1);
+  assert.doesNotThrow(() => parseHash('#/project/%oops'));
+  assert.equal(resolveStep(3, 99, 1), 1);
+});
